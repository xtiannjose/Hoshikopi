# Copy to .env.local and fill in what you have (docs/06-SETUP.md section 5).
# Never commit real values. Every outside account is optional at first.

# Phase 0
DATABASE_URL=postgresql://postgres:dev@127.0.0.1:5434/hoshikopi
DIRECT_URL=postgresql://postgres:dev@127.0.0.1:5434/hoshikopi
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 2: empty RESEND_API_KEY writes emails to the terminal
RESEND_API_KEY=
MAIL_FROM=Hoshikopi <onboarding@resend.dev>
CRON_SECRET=

# Phase 3: fake or paymongo; PayMongo keys must be sk_test_ (sk_live_ is refused)
PAYMENT_PROVIDER=fake
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Phase 4: empty turns Google sign-in off
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phase 6: empty stores photos in public/menu/
BLOB_READ_WRITE_TOKEN=
